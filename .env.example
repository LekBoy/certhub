# Copie para .env e preencha. O .env nunca vai para o Git.
DJANGO_SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_ALLOWED_HOSTS=infrahub.empresa.pt,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://infrahub.empresa.pt
# DJANGO_DEBUG=1              # só em desenvolvimento

# Base de dados. Sem DB_ENGINE usa SQLite (desenvolvimento).
# DB_ENGINE=postgresql
# DB_NAME=infrahub
# DB_USER=infrahub
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Assinatura
SIGNTOOL_PATH=C:\Program Files (x86)\Windows Kits\10\bin\10.0.28000.0\x64\signtool.exe
# SIGN_TIMESTAMP_URL=http://timestamp.digicert.com

# DigiCert KeyLocker
# SM_HOST=https://clientauth.one.digicert.com
# SM_API_KEY=
# SM_CLIENT_CERT_FILE=C:\infrahub\secrets\cliente.p12
# SM_CLIENT_CERT_PASSWORD=

# Descarga controlada de .pfx (CertHub): chave que cifra os .pfx guardados. Gerar com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde uma cópia no cofre: sem ela os .pfx guardados não se conseguem decifrar.
# INFRAHUB_FILE_KEY=<chave>

# MinIO (S3), opcional: só para casos específicos
# MINIO_ENDPOINT=http://servidor:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET_NAME=infrahub

# Notificações por e-mail (ver docs/notificacoes.md)
# INFRAHUB_SMTP_PASSWORD=
# INFRAHUB_GRAPH_CLIENT_SECRET=
