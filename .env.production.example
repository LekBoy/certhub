# =====================================================================
# InfraHub: configuração de PRODUÇÃO (Windows Server + IIS + PostgreSQL)
#
# Na VM:  copy .env.production.example .env   e preencher os valores <...>
# O .env NUNCA vai para o Git. Só a conta do Application Pool e os
# administradores devem poder lê-lo (permissões NTFS).
# O .env só é lido no arranque: reinicie o site (iisreset) depois de o alterar.
# =====================================================================

# --- Django ----------------------------------------------------------
# Gerar uma chave NOVA para a produção (nunca reutilizar a de desenvolvimento):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=<gerar-chave-nova>
# Não definir DJANGO_DEBUG em produção.
DJANGO_ALLOWED_HOSTS=infrahub.empresa.pt,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://infrahub.empresa.pt
# HTTPS (o web.config também define esta variável): cookies seguros e HSTS
DJANGO_BEHIND_HTTPS=1

# --- Base de dados (PostgreSQL) ---------------------------------------
DB_ENGINE=postgresql
DB_NAME=infrahub
DB_USER=infrahub
DB_PASSWORD=<palavra-passe-do-utilizador-infrahub>
DB_HOST=localhost
DB_PORT=5432

# --- Assinatura -------------------------------------------------------
# Caminho completo do signtool (a pasta da versão pode ser diferente)
SIGNTOOL_PATH=C:\Program Files (x86)\Windows Kits\10\bin\10.0.28000.0\x64\signtool.exe
# Servidor de timestamp RFC 3161 (com DigiCert: o deles). Vazio = sem timestamp.
SIGN_TIMESTAMP_URL=http://timestamp.digicert.com
SIGN_VERIFY=1
SIGN_MAX_UPLOAD_MB=100

# --- DigiCert KeyLocker (quando o certificado estiver emitido) ---------
# Têm de estar acessíveis à MESMA conta que corre o Application Pool.
# SM_HOST=https://clientauth.one.digicert.com
# SM_API_KEY=<api-key>
# SM_CLIENT_CERT_FILE=C:\infrahub\secrets\cliente.p12
# SM_CLIENT_CERT_PASSWORD=<palavra-passe-do-p12>

# --- Notificações por e-mail (configuração em Administração > Notificações)
# Só os segredos ficam aqui:
# INFRAHUB_SMTP_PASSWORD=<palavra-passe-smtp>
# INFRAHUB_GRAPH_CLIENT_SECRET=<segredo-da-app-microsoft-graph>

# --- MinIO / S3 (opcional, só para casos específicos) -----------------
# MINIO_ENDPOINT=http://servidor:9000
# MINIO_ACCESS_KEY=<chave-nova>
# MINIO_SECRET_KEY=<segredo-novo>
# MINIO_BUCKET_NAME=infrahub
