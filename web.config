<?xml version="1.0" encoding="utf-8"?>
<!-- IIS: arranca o waitress com o HttpPlatformHandler. Ajuste o caminho se a aplicação não estiver em C:\infrahub. -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="C:\infrahub\venv\Scripts\waitress-serve.exe"
                  arguments="--listen=127.0.0.1:%HTTP_PLATFORM_PORT% --url-scheme=https config.wsgi:application"
                  startupTimeLimit="60" requestTimeout="00:10:00"
                  stdoutLogEnabled="true" stdoutLogFile="C:\infrahub\logs\waitress.log">
      <environmentVariables>
        <environmentVariable name="DJANGO_BEHIND_HTTPS" value="1" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering>
        <!-- uploads até 200 MB (o limite da aplicação é SIGN_MAX_UPLOAD_MB) -->
        <requestLimits maxAllowedContentLength="209715200" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
